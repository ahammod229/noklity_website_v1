VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>
VITE_SUPABASE_ANON_KEY=<legacy-anon-or-publishable-key>
