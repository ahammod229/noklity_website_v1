VITE_ADMIN_EMAILS=<comma-separated-admin-emails>
VITE_SUPER_ADMIN_EMAILS=<comma-separated-super-admin-emails>

# MERN backend
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/noklity
CLIENT_ORIGIN=http://localhost:3000

# Tenant config overrides (optional; DB values take precedence unless overridden here)
