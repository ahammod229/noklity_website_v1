VITE_TENANT_SECONDARY_COLOR=#0f172a
VITE_TENANT_SUPPORT_EMAIL=
VITE_TENANT_COMPANY_NAME=
VITE_TENANT_COMPANY_ADDRESS=
VITE_TENANT_COMPANY_PHONE=
VITE_TENANT_DOMAIN=
VITE_TENANT_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_TENANT_TIMEZONE=Asia/Dhaka
VITE_TENANT_CURRENCY=BDT
VITE_TENANT_PLAN_NAME=Enterprise
VITE_TENANT_FEATURE_FLAGS={"support_tickets":true}
VITE_TENANT_LICENSE_KEY=
VITE_TENANT_LICENSE_STATUS=active
VITE_TENANT_LICENSE_BYPASS=false

# Firebase Auth (replace placeholders with values from Firebase Console > Project Settings > Your apps)
